{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion$|PromptForUserInput$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/ask-context/ask-context-gate.cjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "asyncRewake": true,
            "command": "f=\"$HOME/.claude/safe-compact-$(grep -o '\"session_id\": *\"[^\"]*\"' | cut -d'\"' -f4).md\"; if [ -f \"$f\" ]; then cat \"$f\" >&2; rm \"$f\"; exit 2; fi; true"
          }
        ]
      }
    ]
  }
}
